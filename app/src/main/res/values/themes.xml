<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Apple Minimalist Theme (Light: Red & White) -->
    <style name="Theme.AirShare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Accent: Apple Crimson Red -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_variant</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Backgrounds & Surfaces: Clean White & Warm Gray -->
        <item name="android:colorBackground">@color/bg_light_main</item>
        <item name="colorSurface">@color/bg_light_card</item>
        <item name="colorOnSurface">@color/text_light_primary</item>
        <item name="colorSurfaceVariant">@color/bg_light_elevated</item>
        <item name="colorOutline">@color/border_light</item>

        <!-- Status bar and navigation bar: Apple Translucent Clean -->
        <item name="android:statusBarColor">@color/bg_light_main</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Apple Minimalist Squircle Card (Light) -->
    <style name="Card.AirShare" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="cardBackgroundColor">@color/bg_light_card</item>
    </style>

    <!-- Apple Primary Action Button (Red Capsule) -->
    <style name="Button.AirShare.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Apple Secondary Action Button (Subtle Gray Capsule) -->
    <style name="Button.AirShare.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/bg_light_elevated</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:textColor">@color/text_light_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
