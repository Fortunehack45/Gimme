<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Apple Minimalist Theme (Dark: Red & Black) -->
    <style name="Theme.AirShare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Accent: Apple Crimson Red Dark -->
        <item name="colorPrimary">@color/brand_primary_dark</item>
        <item name="colorPrimaryVariant">@color/brand_primary_variant</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Backgrounds & Surfaces: OLED Pitch Black & Slate Grays -->
        <item name="android:colorBackground">@color/bg_dark_main</item>
        <item name="colorSurface">@color/bg_dark_card</item>
        <item name="colorOnSurface">@color/text_dark_primary</item>
        <item name="colorSurfaceVariant">@color/bg_dark_elevated</item>
        <item name="colorOutline">@color/border_dark</item>

        <!-- Status bar and navigation bar: Apple Translucent Dark -->
        <item name="android:statusBarColor">@color/bg_dark_main</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Apple Minimalist Squircle Card (Dark) -->
    <style name="Card.AirShare" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_dark</item>
        <item name="cardBackgroundColor">@color/bg_dark_card</item>
    </style>

    <!-- Apple Primary Action Button (Red Capsule) -->
    <style name="Button.AirShare.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_primary_dark</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Apple Secondary Action Button (Dark Gray Capsule) -->
    <style name="Button.AirShare.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/bg_dark_elevated</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:textColor">@color/text_dark_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Custom Bottom Navigation Indicator -->
    <style name="Widget.AirShare.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_primary_subtle</item>
        <item name="android:width">48dp</item>
        <item name="android:height">32dp</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
